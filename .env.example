# ---------------------------------------------------------------- Sanity (CMS)
# Project ID is shown in the Sanity dashboard after `npx sanity init`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Read token. Only needed if you set the dataset to private, or want draft
# previews. A public dataset works fine for a fleet listing.
SANITY_API_READ_TOKEN=

# ---------------------------------------------------------------- Email
# https://resend.com  - free tier covers this site comfortably.
RESEND_API_KEY=

# Where enquiries land. Change this one value to redirect every form.
CONTACT_TO_EMAIL=info@affordablecarrentals.com.au

# Must be on a domain verified in Resend. Do NOT use a gmail/outlook address.
CONTACT_FROM_EMAIL=website@affordablecarrentals.com.au

# ---------------------------------------------------------------- Site
NEXT_PUBLIC_SITE_URL=https://www.affordablecarrentals.com.au
